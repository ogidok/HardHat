#!/usr/bin/env bash
set -euo pipefail

HARDHAT_VERSION="0.1.0-dev"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

# Global flags used by modules and shared libs.
HARDHAT_DRY_RUN=0
HARDHAT_ASSUME_YES=0
HARDHAT_OUTPUT_JSON=0
HARDHAT_VERBOSE=0
HARDHAT_NO_COLOR=0
HARDHAT_COMMAND=""
HARDHAT_SUBCOMMAND=""
HARDHAT_ARGS=()
HARDHAT_SHOW_HELP=0
HARDHAT_SHOW_VERSION=0

source "${ROOT_DIR}/lib/colors.sh"
source "${ROOT_DIR}/lib/log.sh"
source "${ROOT_DIR}/lib/common.sh"
source "${ROOT_DIR}/lib/detect.sh"
source "${ROOT_DIR}/lib/validate.sh"
source "${ROOT_DIR}/lib/json.sh"
source "${ROOT_DIR}/lib/i18n.sh"
source "${ROOT_DIR}/lib/confirm.sh"
source "${ROOT_DIR}/lib/backup.sh"
source "${ROOT_DIR}/lib/sudo.sh"
source "${ROOT_DIR}/lib/privileges.sh"

source "${ROOT_DIR}/modules/ports.sh"
source "${ROOT_DIR}/modules/services.sh"
source "${ROOT_DIR}/modules/ssh_audit.sh"
source "${ROOT_DIR}/modules/updates.sh"
source "${ROOT_DIR}/modules/firewall.sh"
source "${ROOT_DIR}/modules/audit.sh"

hardhat_usage() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    cat <<'EOF'
HardHat - Bootstrapper de seguridad Linux para Arch Linux

Uso:
  hardhat [opciones globales] <comando> [subcomando]

Nota:
  Las opciones globales pueden ir antes o despues del comando.
  Ejemplos: hardhat --json audit | hardhat audit --json

Comandos:
  audit               Ejecuta auditoria de seguridad baseline
  firewall audit      Audita estado de UFW y politica baseline
  firewall apply      Aplica baseline de UFW (guiado)
  language show       Muestra idioma actual
  language set <id>   Configura idioma (en|es)
  menu                Abre menu interactivo (no implementado)
  help                Muestra esta ayuda
  version             Muestra version

Opciones globales:
  --dry-run           Muestra plan sin modificar el sistema
  --yes               Omite confirmacion global interactiva
  --json              Emite salida JSON para automatizacion
  --verbose           Habilita logs detallados
  --no-color          Desactiva colores ANSI
  --help              Muestra esta ayuda
  --version           Muestra version

Ejemplos:
  hardhat audit
  hardhat audit --json
  hardhat firewall audit
  hardhat firewall apply --dry-run
  hardhat language set es
EOF
    return
  fi

  cat <<'EOF'
HardHat - Linux Security Bootstrapper for Arch Linux

Usage:
  hardhat [global options] <command> [subcommand]

Note:
  Global options can be passed before or after the command.
  Examples: hardhat --json audit | hardhat audit --json

Commands:
  audit               Run baseline security audit
  firewall audit      Audit UFW status and baseline policy
  firewall apply      Apply UFW baseline policy (guided)
  language show       Show current language
  language set <id>   Set language (en|es)
  menu                Open interactive menu (not implemented yet)
  help                Show this help
  version             Show version

Global options:
  --dry-run           Show planned actions without changing system
  --yes               Skip interactive global confirmation
  --json              Emit machine-friendly JSON output
  --verbose           Enable verbose logs
  --no-color          Disable ANSI colors
  --help              Show this help
  --version           Show version

Examples:
  hardhat audit
  hardhat audit --json
  hardhat firewall audit
  hardhat firewall apply --dry-run
  hardhat language set en
EOF
}

hardhat_language_usage() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    cat <<'EOF'
Uso:
  hardhat language show
  hardhat language set <en|es>
EOF
    return
  fi

  cat <<'EOF'
Usage:
  hardhat language show
  hardhat language set <en|es>
EOF
}

hardhat_run_language_command() {
  local subcommand="${HARDHAT_ARGS[1]:-show}"
  local lang_value="${HARDHAT_ARGS[2]:-}"

  case "${subcommand}" in
    show)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        printf 'Idioma actual: %s\n' "${HARDHAT_LANG}"
      else
        printf 'Current language: %s\n' "${HARDHAT_LANG}"
      fi
      ;;
    set)
      if [[ -z "${lang_value}" ]]; then
        hardhat_log_error "Missing language value (en|es)."
        hardhat_language_usage
        return 1
      fi

      if ! hardhat_validate_language_code "${lang_value}"; then
        hardhat_log_error "Unsupported language: ${lang_value}. Use en or es."
        return 1
      fi

      if ! hardhat_language_set_user "${lang_value}"; then
        hardhat_log_error "Unable to write user language config."
        return 1
      fi

      HARDHAT_LANG="${lang_value}"
      if [[ "${HARDHAT_LANG}" == "es" ]]; then
        hardhat_log_success "Idioma configurado a es."
      else
        hardhat_log_success "Language set to en."
      fi
      ;;
    help)
      hardhat_language_usage
      ;;
    *)
      hardhat_log_error "Unknown language subcommand: ${subcommand}"
      hardhat_language_usage
      return 1
      ;;
  esac
}

hardhat_parse_global_flags() {
  local -a positionals=()
  local arg
  local stop_flag_parsing=0

  for arg in "$@"; do
    if [[ "${stop_flag_parsing}" -eq 1 ]]; then
      positionals+=("${arg}")
      continue
    fi

    case "${arg}" in
      --dry-run)
        HARDHAT_DRY_RUN=1
        ;;
      --yes)
        HARDHAT_ASSUME_YES=1
        ;;
      --json)
        HARDHAT_OUTPUT_JSON=1
        ;;
      --verbose)
        HARDHAT_VERBOSE=1
        ;;
      --no-color)
        HARDHAT_NO_COLOR=1
        ;;
      --help)
        HARDHAT_SHOW_HELP=1
        ;;
      --version)
        HARDHAT_SHOW_VERSION=1
        ;;
      --)
        stop_flag_parsing=1
        ;;
      -*)
        hardhat_log_error "Unknown option: ${arg}"
        hardhat_usage
        exit 1
        ;;
      *)
        positionals+=("${arg}")
        ;;
    esac
  done

  if [[ "${HARDHAT_SHOW_HELP}" -eq 1 ]]; then
    hardhat_usage
    exit 0
  fi

  if [[ "${HARDHAT_SHOW_VERSION}" -eq 1 ]]; then
    printf '%s\n' "${HARDHAT_VERSION}"
    exit 0
  fi

  HARDHAT_ARGS=("${positionals[@]}")
}

hardhat_parse_command() {
  HARDHAT_COMMAND="${HARDHAT_ARGS[0]:-help}"
  HARDHAT_SUBCOMMAND="${HARDHAT_ARGS[1]:-}"
}

hardhat_command_requires_arch() {
  case "${HARDHAT_COMMAND}" in
    audit|firewall|menu)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

hardhat_run_command() {
  case "${HARDHAT_COMMAND}" in
    audit)
      hardhat_module_audit_run "${HARDHAT_ARGS[@]:1}"
      ;;
    firewall)
      hardhat_module_firewall_run "${HARDHAT_ARGS[@]:1}"
      ;;
    language)
      hardhat_run_language_command
      ;;
    menu)
      hardhat_log_warn "menu command is not implemented yet."
      hardhat_log_info "Use 'hardhat help' to see available commands."
      ;;
    help)
      hardhat_usage
      ;;
    version)
      printf '%s\n' "${HARDHAT_VERSION}"
      ;;
    *)
      hardhat_log_error "Unknown command: ${HARDHAT_COMMAND}"
      hardhat_usage
      return 1
      ;;
  esac
}

main() {
  hardhat_parse_global_flags "$@"
  hardhat_language_load
  hardhat_init_colors
  hardhat_parse_command

  if hardhat_command_requires_arch; then
    hardhat_require_arch_or_exit
  fi

  hardhat_run_command
}

main "$@"