#!/usr/bin/env bash
set -euo pipefail

HARDHAT_VERSION="1.0.4"

hardhat_resolve_script_path() {
  local source_path="${BASH_SOURCE[0]}"
  while [[ -L "${source_path}" ]]; do
    local source_dir
    source_dir="$(cd -P -- "$(dirname -- "${source_path}")" && pwd)"
    source_path="$(readlink -- "${source_path}")"
    [[ "${source_path}" != /* ]] && source_path="${source_dir}/${source_path}"
  done
  cd -P -- "$(dirname -- "${source_path}")" && pwd
}

SCRIPT_DIR="$(hardhat_resolve_script_path)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

# Global flags used by modules and shared libs.
HARDHAT_DRY_RUN=0
HARDHAT_ASSUME_YES=0
HARDHAT_OUTPUT_JSON=0
HARDHAT_VERBOSE=0
HARDHAT_NO_COLOR=0
HARDHAT_COMMAND=""
HARDHAT_SUBCOMMAND=""
HARDHAT_ARGS=()
HARDHAT_SHOW_HELP=0
HARDHAT_SHOW_VERSION=0
HARDHAT_BANNER_FILE="${ROOT_DIR}/accsi.txt"

source "${ROOT_DIR}/lib/colors.sh"
source "${ROOT_DIR}/lib/log.sh"
source "${ROOT_DIR}/lib/common.sh"
source "${ROOT_DIR}/lib/detect.sh"
source "${ROOT_DIR}/lib/validate.sh"
source "${ROOT_DIR}/lib/json.sh"
source "${ROOT_DIR}/lib/i18n.sh"
source "${ROOT_DIR}/lib/confirm.sh"
source "${ROOT_DIR}/lib/backup.sh"
source "${ROOT_DIR}/lib/sudo.sh"
source "${ROOT_DIR}/lib/privileges.sh"

source "${ROOT_DIR}/modules/ports.sh"
source "${ROOT_DIR}/modules/services.sh"
source "${ROOT_DIR}/modules/ssh_audit.sh"
source "${ROOT_DIR}/modules/updates.sh"
source "${ROOT_DIR}/modules/firewall.sh"
source "${ROOT_DIR}/modules/audit.sh"
source "${ROOT_DIR}/modules/uninstall.sh"

hardhat_usage() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    cat <<'EOF'
HardHat - Bootstrapper de seguridad Linux para Arch Linux

Uso:
  hardhat [opciones globales] <comando> [subcomando]

Nota:
  Las opciones globales pueden ir antes o despues del comando.
  Ejemplos: hardhat --json audit | hardhat audit --json

Comandos:
  audit               Ejecuta auditoria de seguridad de linea base
  firewall audit      Audita estado de UFW y politica de linea base
  firewall apply      Aplica linea base de UFW (guiado; instala UFW si falta)
  uninstall           Desinstala HardHat de forma segura
  language show       Muestra idioma actual
  language set <id>   Configura idioma (en|es)
  menu                Abre menu interactivo
  help                Muestra esta ayuda
  version             Muestra version

Opciones globales:
  --dry-run           Muestra plan sin modificar el sistema
  --yes               Omite confirmacion global interactiva
  --json              Emite salida JSON para automatizacion
  --verbose           Habilita logs detallados
  --no-color          Desactiva colores ANSI
  -h, --help          Muestra esta ayuda
  --version           Muestra version

Ejemplos:
  hardhat audit
  hardhat audit --json
  hardhat firewall audit
  hardhat firewall apply --dry-run
  hardhat uninstall --dry-run --yes
  hardhat language set es
EOF
    return
  fi

  cat <<'EOF'
HardHat - Linux Security Bootstrapper for Arch Linux

Usage:
  hardhat [global options] <command> [subcommand]

Note:
  Global options can be passed before or after the command.
  Examples: hardhat --json audit | hardhat audit --json

Commands:
  audit               Run baseline security audit
  firewall audit      Audit UFW status and baseline policy
  firewall apply      Apply UFW baseline policy (guided; installs UFW if missing)
  uninstall           Uninstall HardHat safely
  language show       Show current language
  language set <id>   Set language (en|es)
  menu                Open interactive menu
  help                Show this help
  version             Show version

Global options:
  --dry-run           Show planned actions without changing system
  --yes               Skip interactive global confirmation
  --json              Emit machine-friendly JSON output
  --verbose           Enable verbose logs
  --no-color          Disable ANSI colors
  -h, --help          Show this help
  --version           Show version

Examples:
  hardhat audit
  hardhat audit --json
  hardhat firewall audit
  hardhat firewall apply --dry-run
  hardhat uninstall --dry-run --yes
  hardhat language set en
EOF
}

hardhat_language_usage() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    cat <<'EOF'
HardHat language - Gestion de idioma

Uso:
  hardhat language show
  hardhat language set <en|es>
  hardhat language help

Descripcion:
  Muestra o configura el idioma de mensajes de la CLI.

Ejemplos:
  hardhat language show
  hardhat language set es
EOF
    return
  fi

  cat <<'EOF'
HardHat language - Language management

Usage:
  hardhat language show
  hardhat language set <en|es>
  hardhat language help

Description:
  Shows or sets the CLI message language.

Examples:
  hardhat language show
  hardhat language set en
EOF
}

hardhat_help_for_command() {
  local command="${1:-}"
  local subcommand="${2:-}"

  case "${command}" in
    ""|help)
      hardhat_usage
      ;;
    audit)
      hardhat_module_audit_usage
      ;;
    firewall)
      case "${subcommand}" in
        ""|help)
          hardhat_module_firewall_usage
          ;;
        audit)
          hardhat_module_firewall_audit_usage
          ;;
        apply)
          hardhat_module_firewall_apply_usage
          ;;
        *)
          if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
            hardhat_log_error "Subcomando desconocido para firewall help: ${subcommand}"
          else
            hardhat_log_error "Unknown subcommand for firewall help: ${subcommand}"
          fi
          hardhat_module_firewall_usage
          return 1
          ;;
      esac
      ;;
    uninstall)
      hardhat_module_uninstall_usage
      ;;
    language)
      hardhat_language_usage
      ;;
    menu)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        printf 'Uso:\n'
        printf '  hardhat menu\n\n'
        printf 'Descripcion:\n'
        printf '  Abre un menu interactivo con accesos rapidos a comandos del MVP.\n\n'
        printf 'Notas:\n'
        printf '  - Requiere terminal TTY interactiva (stdin/stdout).\n'
        printf '  - No es compatible con --json.\n'
      else
        printf 'Usage:\n'
        printf '  hardhat menu\n\n'
        printf 'Description:\n'
        printf '  Open an interactive menu with quick access to MVP commands.\n\n'
        printf 'Notes:\n'
        printf '  - Requires an interactive TTY terminal (stdin/stdout).\n'
        printf '  - Not compatible with --json.\n'
      fi
      ;;
    version)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        printf 'Uso:\n  hardhat version\n'
      else
        printf 'Usage:\n  hardhat version\n'
      fi
      ;;
    *)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        hardhat_log_error "Comando desconocido para help: ${command}"
      else
        hardhat_log_error "Unknown command for help: ${command}"
      fi
      hardhat_usage
      return 1
      ;;
  esac
}

hardhat_banner_target_fd() {
  if [[ "${HARDHAT_OUTPUT_JSON:-0}" -eq 1 ]]; then
    printf '2'
    return 0
  fi

  printf '1'
}

hardhat_show_ascii_banner() {
  # In JSON mode, suppress branding/banner entirely to keep automation output predictable.
  if [[ "${HARDHAT_OUTPUT_JSON:-0}" -eq 1 ]]; then
    return 0
  fi

  [[ -f "${HARDHAT_BANNER_FILE}" ]] || return 0

  local target_fd
  target_fd="$(hardhat_banner_target_fd)"

  if [[ -t 1 ]]; then
    printf '\033[31m' >&"${target_fd}"
    cat "${HARDHAT_BANNER_FILE}" >&"${target_fd}"
    printf '\033[0m\n' >&"${target_fd}"
  else
    cat "${HARDHAT_BANNER_FILE}" >&"${target_fd}"
    printf '\n' >&"${target_fd}"
  fi
}

hardhat_run_language_command() {
  local subcommand="${HARDHAT_ARGS[1]:-show}"
  local lang_value="${HARDHAT_ARGS[2]:-}"

  case "${subcommand}" in
    -h|--help|help)
      hardhat_language_usage
      ;;
    show)
      if [[ -n "${lang_value}" ]]; then
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_error "El subcomando 'show' no acepta argumentos extra."
        else
          hardhat_log_error "The 'show' subcommand does not accept extra arguments."
        fi
        hardhat_language_usage
        return 1
      fi
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        printf 'Idioma actual: %s\n' "${HARDHAT_LANG}"
      else
        printf 'Current language: %s\n' "${HARDHAT_LANG}"
      fi
      ;;
    set)
      if [[ -z "${lang_value}" ]]; then
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_error "Falta valor de idioma (en|es)."
        else
          hardhat_log_error "Missing language value (en|es)."
        fi
        hardhat_language_usage
        return 1
      fi

      if ! hardhat_validate_language_code "${lang_value}"; then
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_error "Idioma no soportado: ${lang_value}. Usa en o es."
        else
          hardhat_log_error "Unsupported language: ${lang_value}. Use en or es."
        fi
        return 1
      fi

      if ! hardhat_language_set_user "${lang_value}"; then
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_error "No se pudo escribir la configuracion de idioma del usuario."
        else
          hardhat_log_error "Unable to write user language config."
        fi
        return 1
      fi

      HARDHAT_LANG="${lang_value}"
      if [[ "${HARDHAT_LANG}" == "es" ]]; then
        hardhat_log_success "Idioma configurado a es."
      else
        hardhat_log_success "Language set to en."
      fi
      ;;
    *)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        hardhat_log_error "Subcomando de language desconocido: ${subcommand}"
      else
        hardhat_log_error "Unknown language subcommand: ${subcommand}"
      fi
      hardhat_language_usage
      return 1
      ;;
  esac
}

hardhat_menu_needs_tty() {
  if [[ -t 0 && -t 1 ]]; then
    return 0
  fi

  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    hardhat_log_error "El menu interactivo requiere una terminal TTY (stdin/stdout interactivos)."
  else
    hardhat_log_error "Interactive menu requires a TTY terminal (interactive stdin/stdout)."
  fi
  return 1
}

hardhat_menu_print_header() {
  hardhat_show_ascii_banner

  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    printf '\nMenu principal de HardHat\n'
    printf 'Selecciona una opcion:\n'
    return 0
  fi

  printf '\nHardHat Main Menu\n'
  printf 'Select an option:\n'
}

hardhat_menu_clear_screen() {
  if command -v clear >/dev/null 2>&1; then
    clear
    return 0
  fi

  # ANSI fallback when clear is unavailable.
  printf '\033[2J\033[H'
}

hardhat_menu_print_options() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    printf '  1) Ejecutar audit\n'
    printf '  2) Ejecutar firewall audit\n'
    printf '  3) Ejecutar firewall apply\n'
    printf '  4) Ejecutar uninstall\n'
    printf '  5) Ver idioma actual\n'
    printf '  6) Cambiar idioma\n'
    printf '  7) Salir\n'
    return 0
  fi

  printf '  1) Run audit\n'
  printf '  2) Run firewall audit\n'
  printf '  3) Run firewall apply\n'
  printf '  4) Run uninstall\n'
  printf '  5) Show current language\n'
  printf '  6) Set language\n'
  printf '  7) Exit\n'
}

hardhat_menu_prompt_text() {
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    printf 'Opcion [1-7]: '
    return 0
  fi

  printf 'Option [1-7]: '
}

hardhat_menu_pause() {
  local prompt
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    prompt='Presiona Enter para volver al menu...'
  else
    prompt='Press Enter to return to the menu...'
  fi
  read -r -p "${prompt}" _
}

hardhat_menu_run_language_set() {
  local lang_value=""
  if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
    read -r -p "Nuevo idioma (en|es): " lang_value
  else
    read -r -p "New language (en|es): " lang_value
  fi

  if [[ -z "${lang_value}" ]]; then
    if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
      hardhat_log_warn "No se ingreso idioma; se mantiene la configuracion actual."
    else
      hardhat_log_warn "No language entered; keeping current configuration."
    fi
    return 0
  fi

  HARDHAT_ARGS=("language" "set" "${lang_value}")
  hardhat_run_language_command
}

hardhat_run_menu_command() {
  local menu_arg="${HARDHAT_ARGS[1]:-}"
  local choice=""
  local prompt=""

  case "${menu_arg}" in
    "")
      ;;
    -h|--help|help)
      hardhat_help_for_command menu
      return 0
      ;;
    *)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        hardhat_log_error "Argumento no valido para menu: ${menu_arg}"
        hardhat_log_info "Usa 'hardhat menu --help' para ver uso."
      else
        hardhat_log_error "Invalid argument for menu: ${menu_arg}"
        hardhat_log_info "Use 'hardhat menu --help' for usage."
      fi
      return 1
      ;;
  esac

  if [[ "${HARDHAT_OUTPUT_JSON:-0}" -eq 1 ]]; then
    if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
      hardhat_log_error "El menu interactivo no es compatible con --json."
    else
      hardhat_log_error "Interactive menu is not compatible with --json."
    fi
    return 1
  fi

  if ! hardhat_menu_needs_tty; then
    return 1
  fi

  while true; do
    hardhat_menu_clear_screen
    hardhat_menu_print_header
    hardhat_menu_print_options
    prompt="$(hardhat_menu_prompt_text)"
    read -r -p "${prompt}" choice

    case "${choice}" in
      1)
        hardhat_module_audit_run || true
        hardhat_menu_pause
        ;;
      2)
        hardhat_module_firewall_run audit || true
        hardhat_menu_pause
        ;;
      3)
        hardhat_module_firewall_run apply || true
        hardhat_menu_pause
        ;;
      4)
        hardhat_module_uninstall_run || true
        hardhat_menu_pause
        ;;
      5)
        HARDHAT_ARGS=("language" "show")
        hardhat_run_language_command || true
        hardhat_menu_pause
        ;;
      6)
        hardhat_menu_run_language_set || true
        hardhat_menu_pause
        ;;
      7|q|Q|exit)
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_info "Saliendo del menu interactivo."
        else
          hardhat_log_info "Leaving interactive menu."
        fi
        return 0
        ;;
      *)
        if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
          hardhat_log_warn "Opcion no valida. Elige un valor entre 1 y 7."
        else
          hardhat_log_warn "Invalid option. Choose a value between 1 and 7."
        fi
        ;;
    esac
  done
}

hardhat_parse_global_flags() {
  local -a positionals=()
  local arg
  local stop_flag_parsing=0
  local seen_command=0

  for arg in "$@"; do
    if [[ "${stop_flag_parsing}" -eq 1 ]]; then
      positionals+=("${arg}")
      continue
    fi

    case "${arg}" in
      --dry-run)
        HARDHAT_DRY_RUN=1
        ;;
      --yes)
        HARDHAT_ASSUME_YES=1
        ;;
      --json)
        HARDHAT_OUTPUT_JSON=1
        ;;
      --verbose)
        HARDHAT_VERBOSE=1
        ;;
      --no-color)
        HARDHAT_NO_COLOR=1
        ;;
      -h|--help)
        if [[ "${seen_command}" -eq 1 ]]; then
          positionals+=("${arg}")
        else
          HARDHAT_SHOW_HELP=1
        fi
        ;;
      --version)
        if [[ "${seen_command}" -eq 1 ]]; then
          positionals+=("${arg}")
        else
          HARDHAT_SHOW_VERSION=1
        fi
        ;;
      --)
        stop_flag_parsing=1
        ;;
      -*)
        if [[ "${seen_command}" -eq 1 ]]; then
          positionals+=("${arg}")
        else
          if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
            hardhat_log_error "Opcion desconocida: ${arg}"
          else
            hardhat_log_error "Unknown option: ${arg}"
          fi
          hardhat_usage
          exit 1
        fi
        ;;
      *)
        positionals+=("${arg}")
        seen_command=1
        ;;
    esac
  done

  if [[ "${HARDHAT_SHOW_HELP}" -eq 1 ]]; then
    hardhat_show_ascii_banner
    hardhat_usage
    exit 0
  fi

  if [[ "${HARDHAT_SHOW_VERSION}" -eq 1 ]]; then
    hardhat_show_ascii_banner
    printf '%s\n' "${HARDHAT_VERSION}"
    exit 0
  fi

  HARDHAT_ARGS=("${positionals[@]}")
}

hardhat_parse_command() {
  HARDHAT_COMMAND="${HARDHAT_ARGS[0]:-help}"
  HARDHAT_SUBCOMMAND="${HARDHAT_ARGS[1]:-}"
}

hardhat_command_requires_arch() {
  case "${HARDHAT_COMMAND}" in
    audit|firewall|menu)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

hardhat_run_command() {
  case "${HARDHAT_COMMAND}" in
    audit)
      hardhat_module_audit_run "${HARDHAT_ARGS[@]:1}"
      ;;
    firewall)
      hardhat_module_firewall_run "${HARDHAT_ARGS[@]:1}"
      ;;
    uninstall)
      hardhat_module_uninstall_run "${HARDHAT_ARGS[@]:1}"
      ;;
    language)
      hardhat_run_language_command
      ;;
    menu)
      hardhat_run_menu_command
      ;;
    help)
      hardhat_help_for_command "${HARDHAT_ARGS[1]:-}" "${HARDHAT_ARGS[2]:-}"
      ;;
    version)
      printf '%s\n' "${HARDHAT_VERSION}"
      ;;
    *)
      if [[ "${HARDHAT_LANG:-en}" == "es" ]]; then
        hardhat_log_error "Comando desconocido: ${HARDHAT_COMMAND}"
        hardhat_log_info "Usa 'hardhat help' para ver uso."
      else
        hardhat_log_error "Unknown command: ${HARDHAT_COMMAND}"
        hardhat_log_info "Use 'hardhat help' for usage."
      fi
      hardhat_usage
      return 1
      ;;
  esac
}

main() {
  hardhat_language_load
  hardhat_parse_global_flags "$@"
  hardhat_init_colors
  hardhat_parse_command

  hardhat_show_ascii_banner

  if hardhat_command_requires_arch; then
    hardhat_require_arch_or_exit
  fi

  hardhat_run_command
}

main "$@"